# Dependencies
node_modules/
frontend/node_modules/
frontend/.nuxt/
frontend/.output/

# Build artifacts
dist/
build/
electron/dist/
*.dmg
*.exe
*.AppImage

# Bundled binaries (downloaded by scripts/fetch-ffmpeg.mjs into bundled/ffmpeg/).
# 126MB universal2 ffmpeg + ffprobe each — out of git for obvious reasons.
# MANIFEST.json IS tracked so the version + hash provenance survives.
bundled/ffmpeg/ffmpeg
bundled/ffmpeg/ffprobe
bundled/ffmpeg-tmp/

# App settings (machine-local)
app-settings.json
last-session.json

# Secrets — per-project API keys (never commit)
projects/*/secrets.json
electron/projects/*/secrets.json

# Project config with API keys (sensitive)
projects/*/config.json

# Job/session state (machine-specific)
projects/*/jobs.json
projects/*/sessions.json

# Legacy runtime data that leaked into the source tree from older dev builds.
# PROJECTS_ROOT now always resolves to Electron userData, but migrateLegacyProjects
# still reads from these paths so leave them in place on disk — just never commit.
electron/projects/
electron/logs/
/projects/

# Test output
test-results.txt

# normalize-icloud-project.ts run artifacts (per-machine, may contain absolute paths)
scripts/normalization-plan.json
scripts/normalization-plan.md
scripts/normalization-execution.log

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Claude Code per-user settings + runtime state (settings.json itself is shared if added)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/launch.json

# Soft-deleted Claude Code worktrees parked in _trash/. Each is a full
# source-tree checkout (50+ MB), so we keep them on disk for inspection
# but never commit — repo bloat would be enormous. Snippets in
# _trash/snippets/ describe what each one was for and the table in
# _trash/README.md tracks the move.
_trash/.claude/worktrees/

# Environment
.env
.env.local
.env.*.local

# Per-machine style-preview cache (regenerated on demand, NOT a project artifact)
.style-previews/
electron/.style-previews/
