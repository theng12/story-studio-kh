{
  "name": "story-studio-kh",
  "productName": "Story Studio KH",
  "version": "1.0.99",
  "private": true,
  "description": "Story Studio KH — story production desktop app for scripts, images, and audio",
  "author": "",
  "license": "MIT",
  "main": "electron/dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n front,ts,electron -c cyan,yellow,magenta \"cd frontend && npx nuxt dev --port 3000\" \"cd electron && npx tsc --watch --preserveWatchOutput\" \"wait-on http://localhost:3000 electron/dist/main.js && electron .\"",
    "dev:frontend": "cd frontend && npx nuxt dev --port 3000",
    "dev:electron": "cd electron && npx tsc --watch --preserveWatchOutput",
    "build:frontend": "cd frontend && npx nuxt generate",
    "build:electron": "cd electron && npx tsc",
    "build": "npm run build:frontend && npm run build:electron",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "dist": "npm run fetch:ffmpeg && npm run build && electron-builder",
    "start": "electron .",
    "test:backend": "cd electron && STORY_STUDIO_DISABLE_LISTEN=1 npx tsx --test server/__tests__/*.test.ts",
    "test:frontend": "cd frontend && npx tsx --import ./__tests__/setup.ts --test __tests__/*.test.ts",
    "test": "npm run test:backend && npm run test:frontend",
    "lint": "eslint electron/server electron/main.ts",
    "lint:fix": "eslint electron/server electron/main.ts --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "~0.52.0",
    "@fal-ai/client": "~1.3.0",
    "cors": "~2.8.5",
    "docx": "~9.5.0",
    "express": "~5.1.0",
    "mammoth": "~1.12.0",
    "openai": "~5.1.0",
    "sharp": "~0.34.5",
    "uuid": "~11.1.0",
    "zod": "~3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@types/cors": "~2.8.17",
    "@types/express": "~5.0.0",
    "@types/node": "~22.0.0",
    "@types/supertest": "~7.2.0",
    "@types/uuid": "~10.0.0",
    "concurrently": "~9.1.0",
    "electron": "~38.8.6",
    "electron-builder": "~26.9.0",
    "eslint": "~10.2.1",
    "supertest": "~7.2.2",
    "tsx": "~4.19.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "~8.59.0",
    "undici": "~6.25.0",
    "wait-on": "~8.0.0"
  }
}
