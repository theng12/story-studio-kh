{
  "appId": "com.storystudio.kh",
  "productName": "Story Studio KH",
  "extraMetadata": {
    "storyRenderProvenance": {
      "format": "studio.render.story-build-provenance.v1",
      "mode": "descriptor-only",
      "descriptors": {
        "profile_digest": "34495ebc66dbb6e0388d11d04a8ecb35736239e2519f5d46a87cc7659c97f7be",
        "tools_digest": "98c25ae582d4ee43ee1cf665192365149f8d9f860c229a0be9da131df43eba8a",
        "compiler_digest": "1239374f6cf60d025ee897c4c6ea394892d2bc146b0f1b2df94e5eaecc86b4a7"
      },
      "qualification": null
    }
  },
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "electron/dist/**/*",
    "electron/preload.cjs",
    "frontend/.output/public/**/*",
    "electron/templates/**/*",
    "package.json",
    "node_modules/**/*",
    "!**/.env*",
    "!**/.DS_Store",
    "!**/*.map",
    "!**/*.db",
    "!**/*.db-*",
    "!**/*.sqlite",
    "!**/*.sqlite3",
    "!**/app-secrets.json*",
    "!**/secrets.json*",
    "!**/jobs.json",
    "!**/logs/**",
    "!**/__tests__/**",
    "!**/test/**",
    "!**/tests/**",
    "!electron/.story-studio-data/**",
    "!electron/.preview-cache/**",
    "!electron/.style-previews/**",
    "!electron/app-settings.json",
    "!electron/last-session.json",
    "!electron/migrations.json",
    "!electron/templates/**/secrets.json*",
    "!electron/templates/**/jobs.json"
  ],
  "asarUnpack": [
    "**/node_modules/sharp/**",
    "**/node_modules/@img/**",
    "**/*.node"
  ],
  "extraResources": [
    {
      "from": "electron/templates",
      "to": "templates",
      "filter": [
        "**/*",
        "!**/.env*",
        "!**/*.db",
        "!**/*.db-*",
        "!**/*.sqlite",
        "!**/*.sqlite3",
        "!**/app-secrets.json*",
        "!**/secrets.json*",
        "!**/jobs.json",
        "!**/logs/**",
        "!**/generated/**",
        "!**/assets/generated/**"
      ]
    },
    { "from": "electron/server/formats",    "to": "formats" },
    { "from": "electron/server/niches",     "to": "niches" },
    { "from": "electron/server/metadata-formulas", "to": "metadata-formulas" },
    { "from": "electron/server/topic-packs", "to": "topic-packs" },
    { "from": "electron/server/thumbnail-templates", "to": "thumbnail-templates" },
    { "from": "electron/server/effects-gallery", "to": "effects-gallery" },
    { "from": "electron/server/content-packs/recovery", "to": "content-packs/recovery" },
    { "from": "bundled/ffmpeg",             "to": "ffmpeg" },
    { "from": "bundled/scene-clip",         "to": "scene-clip", "filter": ["scene-clip"] },
    { "from": "bundled/LICENSE-FFMPEG.txt", "to": "LICENSE-FFMPEG.txt" },
    { "from": "CHANGELOG.md",               "to": "CHANGELOG.md" }
  ],
  "mac": {
    "target": { "target": "dmg", "arch": ["arm64"] },
    "category": "public.app-category.productivity",
    "icon": "build/icon.icns",
    "artifactName": "${productName} ${version}-${arch}.${ext}",
    "extendInfo": {
      "CFBundleName": "Story Studio KH",
      "CFBundleDisplayName": "Story Studio KH"
    }
  },
  "dmg": {
    "title": "Story Studio KH ${version}",
    "artifactName": "${productName} ${version}-${arch}.${ext}",
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" },
      { "x": 270, "y": 380, "type": "file", "path": "build/READ ME FIRST.txt" }
    ]
  }
}
