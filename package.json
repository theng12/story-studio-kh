{
  "name": "story-studio-kh",
  "productName": "Story Studio KH",
  "version": "1.4.386",
  "private": true,
  "description": "Story Studio KH \u2014 continuity-first video pipeline for YouTube channels. Research, scripts, voice, narration-timed scenes, optional motion, and assembly across scenes, listicle, and character-locked formats.",
  "author": "",
  "license": "MIT",
  "main": "electron/dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n front,ts,electron -c cyan,yellow,magenta \"cd frontend && npx nuxt dev --port 3000\" \"cd electron && npx tsc --watch --preserveWatchOutput\" \"wait-on http://localhost:3000 electron/dist/main.js && electron .\"",
    "dev:frontend": "cd frontend && npx nuxt dev --port 3000",
    "dev:electron": "cd electron && npx tsc --watch --preserveWatchOutput",
    "build:frontend": "npm --prefix frontend run generate",
    "build:electron": "node -e \"require('fs').rmSync('electron/dist',{recursive:true,force:true})\" && tsc -p electron/tsconfig.build.json",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:typography": "node scripts/check-typography.mjs",
    "check:security": "node scripts/check-production-security.mjs",
    "check:model-drift": "node scripts/check-model-drift.mjs",
    "check:release": "node scripts/release/check-desktop-release.mjs",
    "check:public-release": "node scripts/release/check-public-release-credentials.mjs",
    "build": "npm run check:changelog && npm run check:typography && npm run check:security && npm run check:model-drift && npm run check:release && npm run build:frontend && npm run build:electron && npm run check:security -- --built && npm run check:release -- --built",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "build:scene-clip": "node scripts/build-scene-clip.mjs",
    "dist": "npm run fetch:ffmpeg && npm run build:scene-clip && npm run build && electron-builder --publish never && npm run verify:artifact",
    "dist:smoke": "node scripts/release/build-unsigned-dmg.mjs",
    "dist:public": "node scripts/release/build-public-dmg.mjs",
    "verify:artifact": "node scripts/release/verify-desktop-artifact.mjs",
    "verify:deps": "node scripts/release/verify-packaged-dependencies.mjs",
    "verify:launch": "node scripts/release/smoke-launch-artifact.mjs",
    "verify:public-artifact": "node scripts/release/verify-signed-desktop-artifact.mjs",
    "content-pack:build": "node scripts/content-packs/build-pack.mjs",
    "content-pack:validate": "node scripts/content-packs/validate-pack.mjs",
    "content-pack:ship": "node scripts/content-packs/ship-pack.mjs",
    "content-pack:registry": "node scripts/content-packs/authoring-registry.mjs",
    "content-pack:index": "node scripts/content-packs/index.mjs",
    "start": "electron .",
    "test:backend": "node scripts/testing/run-backend-tests.mjs",
    "test:frontend": "cd frontend && npx nuxi prepare && node ../scripts/testing/run-lane-tests.mjs frontend",
    "test:release": "node scripts/testing/run-lane-tests.mjs release",
    "test:content-packs": "node scripts/testing/run-lane-tests.mjs content-packs",
    "test": "npm run typecheck && npm run test:backend && npm run test:frontend && npm run test:release && npm run test:content-packs",
    "lint": "eslint electron/server electron/main.ts",
    "lint:fix": "eslint electron/server electron/main.ts --fix",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:electron && npm --prefix frontend run typecheck",
    "verify": "npm run lint && npm test && npm run build",
    "reset-server-auth": "npx tsx scripts/reset-server-auth.ts"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "cors": "~2.8.5",
    "express": "~5.2.1",
    "jszip": "~3.10.1",
    "mammoth": "~1.12.0",
    "onnxruntime-common": "1.31.1",
    "sharp": "^0.35.3",
    "undici": "^6.28.0",
    "zod": "~3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@types/cors": "~2.8.17",
    "@types/express": "~5.0.0",
    "@types/node": "~22.0.0",
    "@types/supertest": "~7.2.0",
    "concurrently": "~9.1.0",
    "electron": "~43.4.0",
    "electron-builder": "~26.15.3",
    "eslint": "~10.2.1",
    "supertest": "~7.2.2",
    "tsx": "~4.19.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "~8.59.0",
    "wait-on": "~8.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true
  }
}
