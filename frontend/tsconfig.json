{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./*"],
      "@shared/contracts": ["../electron/server/contracts/index.ts"],
      "@shared/contextual-cue-position": ["../electron/server/contracts/contextual-cue-position.ts"],
      "@shared/provider-task-state": ["../electron/server/contracts/provider-task-state.ts"],
      "@shared/motion-scope": ["../electron/server/contracts/motion-scope.ts"],
      "@shared/pacing": ["../electron/server/contracts/pacing.ts"],
      "@shared/subtitle-style": ["../electron/server/contracts/subtitle-style.ts"],
      "@shared/subtitle-presets": ["../electron/server/contracts/subtitle-presets.ts"],
      "@shared/subtitle-gaps": ["../electron/server/contracts/subtitle-gaps.ts"],
      "@shared/section-quality": ["../electron/server/contracts/section-quality.ts"],
      "@shared/thumbnail-overlay": ["../electron/server/contracts/thumbnail-overlay.ts"],
      "@shared/scene-effects": ["../electron/server/contracts/scene-effects.ts"],
      "@shared/scene-effect-presets": ["../electron/server/contracts/scene-effect-presets.ts"],
      "@shared/effect-loops": ["../electron/server/contracts/effect-loops.ts"],
      "@shared/effect-params": ["../electron/server/contracts/effect-params.ts"]
    },
    "noUncheckedIndexedAccess": false,
    "noImplicitAny": false,
    "strict": false
  },
  "vueCompilerOptions": {
    "strictTemplates": false
  },
  "exclude": ["__tests__"]
}
