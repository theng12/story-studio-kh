# Dependencies (matches at any depth — no leading slash)
node_modules

# Build / compile outputs
dist/
/.release-dist.lock
.nuxt/
.output/
out/

# Stray nested build dir (created by running nuxt from the wrong cwd)
frontend/frontend/

# Large, re-downloadable binaries
# bundled/ffmpeg is fetched by scripts/fetch-ffmpeg.mjs and shipped as an
# electron-builder extraResource (~250MB) — not source.
bundled/ffmpeg/
# bundled/scene-clip is compiled from native/scene-clip by scripts/build-scene-clip.mjs
bundled/scene-clip/

# Runtime data + generated caches — user content / secrets, never source.
# .story-studio-data holds project files + configs (where API keys live).
.story-studio-data/
.style-previews/
.preview-cache/

# Local runtime state (machine-specific)
app-settings.json
last-session.json
migrations.json
logs/
_trash/

# Credentials and local databases (defense in depth with packaging checks)
.env
.env.*
!.env.example
# Dev-tool session artifacts. `.last-token` held a live bearer token for a
# local brainstorm server; nothing in this repo reads these back, and a
# session's token has no business in version control.
.last-token
.last-port
*.last-token
*.db
*.db-*
*.sqlite
*.sqlite3

# Editor / OS cruft
.DS_Store
*.log
.claude/
.worktrees/
.vscode/
.idea/

# Runtime voice catalog cache (written to repo root in dev mode)
elevenlabs-voices.json

# Ad-hoc test/run output dumped at repo root
test-results.txt

# graphify knowledge-graph output (generated, may be large)
graphify-out/

# Spec-and-evidence directories are SOURCE, never local scratch.
#
# `.git/info/exclude` on the machine these were authored on carried a
# `.superpowers/sdd/` line. That file is local-only and is never committed, so
# the rule was invisible to every other checkout — and it silently swallowed the
# evidence fixtures two backend suites read at runtime. `topic-pack-1000-successors`
# and `thumbnail-recipe-expansion-ten-source` were consequently red for EVERYONE,
# on every branch, with nothing in the repository to explain why.
#
# A `.gitignore` pattern outranks `$GIT_DIR/info/exclude`, so this negation
# disarms that rule wherever it is still present, and does so in a file that
# actually travels with the repository.
!.superpowers/
!.superpowers/**

# ...but that negation is deliberately broad, so it also re-includes anything
# else a dev tool drops in there — including the shapes we removed on
# 2026-08-25 (a live 64-char bearer token at `.superpowers/brainstorm/.last-token`).
# Re-exclude those by shape. A later rule wins, so these must stay AFTER the
# negation above. Verified with `git check-ignore -v`, not assumed.
.superpowers/**/.DS_Store
.superpowers/**/.last-token
.superpowers/**/.last-port
.superpowers/**/*.token
.superpowers/**/*.secret
.superpowers/**/.env
.superpowers/**/.env.*
.test-work
