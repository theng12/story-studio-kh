{
  "appId": "com.storystudio.kh",
  "productName": "Story Studio KH",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "electron/dist/**/*",
    "electron/preload.cjs",
    "frontend/.output/public/**/*",
    "electron/templates/**/*",
    "package.json",
    "node_modules/**/*"
  ],
  "asarUnpack": [
    "**/node_modules/sharp/**",
    "**/node_modules/@img/**",
    "**/*.node"
  ],
  "extraResources": [
    { "from": "electron/templates",         "to": "templates" },
    { "from": "electron/server/formats",    "to": "formats" },
    { "from": "electron/server/niches",     "to": "niches" },
    { "from": "electron/server/patterns",   "to": "patterns" },
    { "from": "bundled/ffmpeg",             "to": "ffmpeg" },
    { "from": "bundled/LICENSE-FFMPEG.txt", "to": "LICENSE-FFMPEG.txt" },
    { "from": "CHANGELOG.md",               "to": "CHANGELOG.md" }
  ],
  "mac": {
    "target": { "target": "dmg", "arch": ["arm64"] },
    "category": "public.app-category.productivity",
    "icon": "build/icon.icns",
    "artifactName": "${productName} ${version}-${arch}.${ext}",
    "extendInfo": {
      "CFBundleName": "Story Studio KH",
      "CFBundleDisplayName": "Story Studio KH"
    }
  },
  "dmg": {
    "title": "Story Studio KH ${version}",
    "artifactName": "${productName} ${version}-${arch}.${ext}",
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" },
      { "x": 270, "y": 380, "type": "file", "path": "build/READ ME FIRST.txt" }
    ]
  }
}
